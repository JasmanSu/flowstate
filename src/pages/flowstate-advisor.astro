    }

    .why-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      min-width: 0;
    }

    .why-item-title {
      font-family: var(--font-display);
      font-size: 1rem;
      font-weight: 600;
      color: var(--white);
      margin: 0;
    }

    .why-item-body {
      font-size: 0.85rem;
      color: rgba(220, 232, 245, 0.75);
      line-height: 1.6;
      margin: 0;
    }

    /* ── Why Us — KLCC backdrop, washed light ── */
    #why-us {
      position: relative;
      isolation: isolate;
      background: var(--white);
    }
    #why-us::before,
    #why-us::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -2;
    }
    #why-us::before {
      background-image: url('https://images.unsplash.com/photo-1566914447826-bf04e54bf1be?w=1800&q=80&fm=jpg&fit=crop');
      background-size: cover;
      background-position: center 40%;
    }
    #why-us::after {
      z-index: -1;
      background: rgba(255,255,255,0.9);
    }

    /* ─── SECTION 8 — CONTACT (split hero) ──────────────────────────── */
    .contact-hero {
      position: relative;
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
      z-index: 20;
    }

    .contact-hero-left {
      background: linear-gradient(135deg, var(--navy-700) 0%, var(--navy-900) 100%);
      color: var(--white);
      padding: clamp(2.5rem, 6vw, 5rem);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 3rem;
    }

    .contact-hero-title {
      font-family: var(--font-display);
      font-size: clamp(2.25rem, 4vw, 3rem);
      font-weight: 700;
      color: var(--white);
      line-height: 1.15;
      margin: 0 0 1.5rem 0;
    }

    .contact-hero-intro {
      font-family: var(--font-display);
      font-style: italic;
      font-size: 1rem;
      color: rgba(255,255,255,0.8);
      line-height: 1.65;
      max-width: 42ch;
      margin: 0;
    }

    .contact-hero-bottom {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .contact-hero-rule {
      height: 1px;
      background: rgba(255,255,255,0.2);
    }

    .contact-hero-brand {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .contact-hero-logo {
      width: 48px;
      height: 48px;
      object-fit: contain;
    }

    .contact-hero-wordmark {
      display: flex;
      flex-direction: column;
    }

    .contact-hero-wm-top {
      font-family: var(--font-display);
      font-size: 1.1rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      color: var(--white);
    }

    .contact-hero-wm-sub {
      font-size: 0.65rem;
      letter-spacing: 0.25em;
      color: rgba(255,255,255,0.6);
      margin-top: 2px;
    }

    .contact-hero-info {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .contact-hero-label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.55);
      display: block;
      margin-bottom: 0.75rem;
    }

    .contact-hero-value {
      display: flex;
      align-items: flex-start;
      gap: 0.6rem;
      font-size: 0.85rem;
      color: rgba(255,255,255,0.9);
      line-height: 1.55;
      margin: 0 0 0.6rem 0;
    }

    .contact-hero-value svg {
      flex-shrink: 0;
      margin-top: 0.15rem;
      color: rgba(255,255,255,0.55);
    }

    .contact-hero-right {
      position: relative;
      isolation: isolate;
      overflow: hidden;
    }

    .contact-hero-image {
      position: absolute;
      inset: 0;
      background-image: url('https://images.unsplash.com/photo-1596422846543-75c6fc197f07?w=1800&q=85');
      background-size: cover;
      background-position: center 35%;
    }

    .contact-hero-card {
      position: absolute;
      right: clamp(1.5rem, 4vw, 3rem);
      bottom: clamp(1.5rem, 4vw, 3rem);
      max-width: 340px;
      background: var(--white);
      border-radius: var(--radius-md);
      padding: 2rem;
      box-shadow: 0 24px 60px rgba(0,0,0,0.3);
