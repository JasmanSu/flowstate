    .contact-card-title {
      font-family: var(--font-display);
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--ink-900);
      margin: 0 0 0.75rem 0;
    }

    .contact-card-body {
      font-size: 0.85rem;
      color: var(--ink-700);
      line-height: 1.65;
      margin: 0;
    }

    .contact-card-rule {
      height: 1px;
      background: var(--border);
      margin: 1.5rem 0 1rem 0;
    }

    .contact-card-note {
      font-size: 0.75rem;
      color: var(--muted);
      font-style: italic;
      margin: 0;
    }

    /* ─── FOOTER ─────────────────────────────────────────────────────── */
    .footer {
      position: relative;
      z-index: 20;
      background: var(--white);
      padding-block: 3rem;
      border-top: 1px solid rgba(255,255,255,0.08);
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.5rem;
    }

    .footer-brand { display: flex; flex-direction: column; gap: 0.35rem; }
    .footer-name {
      font-family: var(--font-display);
      font-size: 1rem;
      font-weight: 600;
      color: var(--black);
    }
    .footer-reg {
      font-size: 0.68rem;
      color: rgba(0,0,0,0.5);
      letter-spacing: 0.04em;
    }

    .footer-links {
      display: flex;
      gap: 1.75rem;
