<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={firm.description} />
  <title>{firm.name} — {firm.tagline}</title>
  <link rel="icon" type="image/png" href="/favicon.png?v=3" />
  <link rel="shortcut icon" type="image/png" href="/favicon.png?v=3" />
  <link rel="apple-touch-icon" href="/favicon.png?v=3" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />

  <style>
    /* ─── DESIGN TOKENS ──────────────────────────────────────────────────
       Colour palette extracted dari Flowstate corporate profile:
       Dark navy (#1a2744) + light blue tint (#dce8f5) + accent blue (#4a7ab5)
    ──────────────────────────────────────────────────────────────────── */
    :root {
      /* Primary palette — dari corporate profile */
      --navy-900:   #1a2744;
      --navy-800:   #1e3a5f;
      --navy-700:   #243858;
      --blue-tint:  #dce8f5;
      --blue-light: #eef4fb;
      --accent:     #4a7ab5;
      --accent-dark:#3a6295;

      /* Neutrals */
      --white:      #ffffff;
      --off-white:  #f8fafc;
      --ink-900:    #1a2744;
      --ink-700:    #2d3f5e;
      --muted:      #6b7a99;

      /* Industry accents */
      --acc-blue:   #4a7ab5;
      --acc-gold:   #B08A2E;
      --acc-green:  #46795E;

      /* Borders */
      --border:        rgba(26,39,68,0.12);
      --border-subtle: rgba(26,39,68,0.07);
      --border-light:  rgba(255,255,255,0.12);

      /* Fonts */
      --font-display: 'Playfair Display', Georgia, serif;
      --font-body:    'Inter', system-ui, sans-serif;

      /* Layout */
      --container: 1200px;
      --pad-x:     clamp(1.25rem, 5vw, 3rem);
      --section-y: clamp(4.5rem, 8vw, 7rem);

      /* Radius */
      --radius-sm: 4px;
      --radius-md: 8px;
      --radius-lg: 12px;
    }

    /* ─── RESET ──────────────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html {
      scroll-behavior: smooth;
      overscroll-behavior-y: none;
      overflow-x: hidden;
      width: 100%;
    }
    body {
      font-family: var(--font-body);
      background: var(--navy-900);
      color: var(--ink-900);
      line-height: 1.65;
      overscroll-behavior-y: none;
      overflow-x: hidden;
      width: 100%;
      -webkit-font-smoothing: antialiased;
    }
    img { max-width: 100%; display: block; object-fit: cover; }
    a { color: inherit; }

    /* ─── LAYOUT UTILITIES ───────────────────────────────────────────── */
    .wrap {
      max-width: var(--container);
      margin-inline: auto;
      padding-inline: var(--pad-x);
    }

    .section {
      position: relative;
      z-index: 20;
      padding-block: var(--section-y);
    }
    .section--tint { background: var(--blue-tint); }
    .section--white { background: var(--white); }
    .section--navy {
      background: var(--navy-900);
      color: var(--white);
    }

    /* Section labels */
    .section-label {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 1.25rem;
    }
    .section-label::before {
      content: '';
      display: block;
      width: 24px;
      height: 1px;
      background: var(--accent);
    }
    .section--navy .section-label {
      color: rgba(220,232,245,0.7);
    }
    .section--navy .section-label::before {
      background: rgba(220,232,245,0.5);
    }

    /* Section titles */
    .section-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 3.5vw, 2.85rem);
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: -0.01em;
      color: var(--ink-900);
    }
    .section--navy .section-title { color: var(--white); }

    .section-title em {
      font-style: italic;
      color: var(--accent);
    }
    .section--navy .section-title em { color: var(--blue-tint); }

    .section-intro {
      font-size: 0.95rem;
      color: var(--muted);
      line-height: 1.8;
      max-width: 60ch;
      margin-top: 1rem;
    }
    .section--navy .section-intro { color: rgba(220,232,245,0.65); }

    /* ─── NAVBAR ─────────────────────────────────────────────────────── */
    .nav {
      position: fixed;
      inset: 0 0 auto 0;
      z-index: 200;
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      gap: 2rem;
      padding-block: 1rem;
    }

    .nav-wordmark {
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.65rem;
      flex-shrink: 0;
    }
    .logo-mark {
      width: 34px; height: 34px;
      border-radius: var(--radius-sm);
      background: var(--navy-900);
      color: var(--blue-tint);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      font-size: 0.85rem;
      font-weight: 700;
      flex-shrink: 0;
      letter-spacing: 0.02em;
    }
    .wm-top {
      font-family: var(--font-display);
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--navy-900);
      display: block;
      line-height: 1;
    }
    .wm-sub {
      font-size: 0.58rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--accent);
      display: block;
      margin-top: 3px;
    }

    .nav-links {
      display: flex;
      gap: 0;
      margin-left: auto;
      list-style: none;
    }
    .nav-links a {
      display: block;
      padding: 0.45rem 0.75rem;
      font-size: 0.78rem;
      font-weight: 500;
      letter-spacing: 0.02em;
      color: var(--muted);
      text-decoration: none;
      border-radius: var(--radius-sm);
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--navy-900); }

    .nav-cta {
      display: inline-block;
      padding: 0.55rem 1.25rem;
      background: var(--navy-900);
      color: var(--white);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
      border-radius: var(--radius-sm);
      transition: background 0.2s;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .nav-cta:hover { background: var(--navy-800); }

    .nav-hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 6px;
      margin-left: auto;
    }
    .nav-hamburger span {
      display: block;
      width: 20px; height: 1.5px;
      background: var(--navy-900);
      transition: all 0.3s;
    }

    .mobile-nav {
      display: none;
      flex-direction: column;
      padding: 1rem var(--pad-x) 1.5rem;
      gap: 0;
      border-top: 1px solid var(--border-subtle);
    }
    .mobile-nav.open { display: flex; }
    .mobile-nav a {
      padding: 0.75rem 0.5rem;
      font-size: 0.875rem;
      color: var(--muted);
      text-decoration: none;
      border-bottom: 1px solid var(--border-subtle);
      transition: color 0.2s;
    }
    .mobile-nav a:last-child { border-bottom: none; }
    .mobile-nav a:hover { color: var(--navy-900); }

    /* ─── SECTION 1 — HERO / HOOK ────────────────────────────────────── */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-top: 0;
      overflow: visible;
      z-index: 1;
      scroll-margin-top: 0;
    }

    /* KLCC background — sticky/fixed on scroll */
    .hero-bg {
      position: fixed;
      inset: 0;
      background-image: url('https://images.unsplash.com/photo-1596422846543-75c6fc197f07?w=1800&q=85');
      background-size: cover;
      background-position: center 30%;
      z-index: -10;
    }

    /* Overlay for text contrast */
    .hero-bg::after {
      content: '';
      position: fixed;
      inset: 0;
      background: linear-gradient(to right, rgba(26,39,68,0.75) 0%, rgba(26,39,68,0.55) 50%, rgba(26,39,68,0.3) 100%);
      z-index: -9;
    }

    /* Left-side blue gradient overlay */
    .hero-bg::before {
      content: '';
      position: fixed;
      inset: 0;
      right: 40%;
      background: linear-gradient(to right, var(--navy-800) 0%, rgba(74,122,181,0) 100%);
      z-index: -8;
      pointer-events: none;
    }

    .hero-inner {
      position: relative;
      z-index: 10;
      width: 100%;
      padding-block: clamp(3rem, 8vw, 6rem);
      display: grid;
      grid-template-columns: 0.75fr 1fr;
      align-items: center;
      justify-items: start;
      gap: 4rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .hero-left {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      align-items: flex-start;
      text-align: left;
    }

    .gradient{
      background: linear-gradient(to right, var(--accent), var(--navy-800));
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.7);
      margin-bottom: 1.5rem;
    }
    .hero-eyebrow::before {
      content: '';
      display: block;
      width: 32px;
      height: 1px;
      background: rgba(255,255,255,0.5);
    }

    .hero-h1 {
      font-family: var(--font-display);
      font-size: clamp(2.75rem, 6vw + 1.5rem, 4.5rem);
      font-weight: 400;
      line-height: 1.12;
      letter-spacing: -0.02em;
      color: var(--white);
      margin-bottom: 0;
      text-shadow: 0 4px 28px rgba(0,0,0,0.35);
    }
    .hero-h1 span {
      display: block;
    }
    .hero-h1 em {
      font-style: italic;
      color: var(--white);
      display: block;
      font-weight: 400;
    }

    .hero-tagline {
      display: block;
      font-family: var(--font-display);
      font-size: clamp(0.9rem, 1.5vw, 1.05rem);
      font-style: italic;
      font-weight: 400;
      color: rgba(255,255,255,0.75);
      margin-top: 1.5rem;
      letter-spacing: 0.01em;
    }

    .hero-right {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      align-items: flex-start;
      justify-content: center;
    }

    .hero-desc {
      font-size: 0.95rem;
      color: rgba(255,255,255,0.8);
      line-height: 1.75;
      max-width: 380px;
      font-weight: 400;
    }

    .hero-actions {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
      justify-content: flex-start;
    }

    .btn-primary {
      display: inline-block;
      padding: 0.9rem 2rem;
      background: var(--white);
      color: var(--navy-900);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      border-radius: 3px;
      transition: background 0.2s, box-shadow 0.2s;
      white-space: nowrap;
    }
    .btn-primary:hover {
      background: rgba(255,255,255,0.95);
      box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }

    .btn-outline-light {
      display: inline-block;
      padding: 0.9rem 1.75rem;
      border: none;
      background: transparent;
      color: var(--white);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-decoration: none;
      border-radius: 3px;
      transition: color 0.2s, opacity 0.2s;
      white-space: nowrap;
    }
    .btn-outline-light:hover {
      color: rgba(255,255,255,0.7);
      opacity: 0.8;
    }

    /* Scroll indicator */
    .hero-scroll {
      position: absolute;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }
    .scroll-label {
      font-size: 0.6rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(220,232,245,0.45);
    }
    .scroll-line {
      width: 1px;
      height: 40px;
      background: linear-gradient(to bottom, rgba(220,232,245,0.4), transparent);
      animation: scrollPulse 2s ease infinite;
    }
    @keyframes scrollPulse {
      0%, 100% { opacity: 0.4; transform: scaleY(1); }
      50% { opacity: 1; transform: scaleY(0.7); }
    }

    /* ─── SECTION 2 — ABOUT ──────────────────────────────────────────── */
    .about-header {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }

    .pillar-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-top: 3.5rem;
    }

    .pillar-card {
      padding: 2rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      display: flex;
      flex-direction: column;
      gap: 1rem;
      background: var(--white);
      transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
    }
    .pillar-card:hover {
      transform: translateY(-4px);
      border-color: var(--accent);
      box-shadow: 0 16px 40px rgba(26,39,68,0.1);
    }

    .pillar-icon {
      width: 36px; height: 36px;
      color: var(--accent);
    }
    .pillar-icon svg { width: 100%; height: 100%; }

    .pillar-title {
      font-family: var(--font-display);
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--ink-900);
    }
    .pillar-body {
      font-size: 0.85rem;
      color: var(--muted);
      line-height: 1.7;
      white-space: pre-line;
    }

    /* ─── SECTION 3 — PURPOSE ────────────────────────────────────────── */
    .purpose-list {
      display: flex;
      flex-direction: column;
      gap: 1px;
      margin-top: 0;
      background: var(--border-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }

    .purpose-row {
      display: grid;
      grid-template-columns: 260px 1fr 320px;
      gap: 2.5rem;
      padding: 2rem 2.25rem;
      background: var(--blue-light);
      transition: background 0.2s;
      align-items: center;
      justify-items: start;
    }
    .purpose-row:hover { background: #e2ecf7; }

    .purpose-heading {
      display: flex;
      gap: 0.875rem;
      align-items: baseline;
    }
    .purpose-num {
      font-family: var(--font-display);
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--accent);
      flex-shrink: 0;
    }
    .purpose-title {
      font-family: var(--font-display);
      font-size: 1rem;
      font-weight: 600;
      color: var(--ink-900);
      line-height: 1.3;
    }
    .purpose-desc {
      font-size: 0.875rem;
      color: var(--ink-700);
      line-height: 1.7;
      text-align: justify;
    }
    .purpose-tags {
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--accent-dark);
      line-height: 1.5;
    }
    .purpose-tags .sep {
      color: var(--accent-dark);
      opacity: 0.8;
      margin: 0 0.35em;
    }

    /* ─── SECTION 4 — TARGET ─────────────────────────────────────────── */
    .target-header {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: start;
    }
    .target-eyebrow {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent);
      display: block;
      margin-bottom: 1rem;
    }
    .target-title {
      font-family: var(--font-display);
      font-size: clamp(2.25rem, 4vw, 3.25rem);
      font-weight: 700;
      color: var(--ink-900);
      line-height: 1.1;
    }
    .target-blurb {
      font-size: 1rem;
      color: var(--muted);
      line-height: 1.75;
      max-width: 40ch;
      padding-top: 2.5rem;
    }

    .target-rule {
      height: 1px;
      background: var(--border);
      margin-top: 2.5rem;
    }

    .target-columns {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      padding-block: 2.5rem;
      border-bottom: 1px solid var(--border-subtle);
    }
    .target-col { position: relative; }
    .target-col:last-child { padding-left: 2rem; }
    .target-col:last-child::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 1px;
      background: var(--border);
    }

    .target-col-label {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--navy-900);
      margin-bottom: 1.25rem;
      display: block;
    }
    .target-items {
      font-size: 0.93rem;
      color: var(--ink-700);
      line-height: 1.9;
    }
    .target-items .sep { color: var(--muted); margin: 0 0.5em; }

    .target-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      padding-top: 1.5rem;
      flex-wrap: wrap;
    }
    .target-caption {
      font-family: var(--font-display);
      font-style: italic;
      font-size: 0.88rem;
      color: var(--muted);
    }
    .target-gradient-bar {
      flex: 1;
      max-width: 300px;
      height: 2px;
      background: linear-gradient(to right, var(--accent), var(--navy-900));
    }

    .industries-title {
      font-family: var(--font-display);
      font-size: clamp(1.6rem, 2.8vw, 2.1rem);
      font-weight: 700;
      color: var(--ink-900);
      margin-top: 4rem;
      margin-bottom: 2rem;
    }

    .industry-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .industry-card {
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      background: var(--white);
      transition: transform 0.25s, box-shadow 0.25s;
    }
    .industry-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 40px rgba(26,39,68,0.1);
    }
    .industry-card[data-accent="blue"]  { border-top: 3px solid var(--acc-blue); }
    .industry-card[data-accent="gold"]  { border-top: 3px solid var(--acc-gold); }
    .industry-card[data-accent="green"] { border-top: 3px solid var(--acc-green); }

    .industry-img {
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
    }

    .industry-body { padding: 1.75rem; }
    .industry-line {
      width: 28px; height: 2px;
      margin-bottom: 1rem;
    }
    .industry-card[data-accent="blue"]  .industry-line { background: var(--acc-blue); }
    .industry-card[data-accent="gold"]  .industry-line { background: var(--acc-gold); }
    .industry-card[data-accent="green"] .industry-line { background: var(--acc-green); }

    .industry-title {
      font-family: var(--font-display);
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--ink-900);
      margin-bottom: 1rem;
    }
    .industry-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }
    .industry-list li {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      font-size: 0.875rem;
      color: var(--ink-700);
    }
    .dot {
      width: 5px; height: 5px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .industry-card[data-accent="blue"]  .dot { background: var(--acc-blue); }
    .industry-card[data-accent="gold"]  .dot { background: var(--acc-gold); }
    .industry-card[data-accent="green"] .dot { background: var(--acc-green); }

    /* ─── SECTION 5+6 — BOARD & TEAM (gabungan) ─────────────────────── */
    .people-section-title {
      font-family: var(--font-display);
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--ink-900);
      letter-spacing: 0.01em;
      margin-bottom: 1.75rem;
      padding-bottom: 0.875rem;
      border-bottom: 1px solid var(--border);
    }

    .people-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.75rem;
    }
    .people-grid.board-grid {
      grid-template-columns: 1fr 1fr 1.18fr 1fr 1fr;
      align-items: start;
    }
    .people-grid.team-grid {
      grid-template-columns: repeat(4, 1fr);
      max-width: 80%;
      margin: 3.5rem auto 0;
      gap: 1.5rem;
      justify-items: center;
      align-items: start;
    }
    .team-grid .person-card { width: 100%; }

    .person-card {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      cursor: pointer;
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .person-card:hover {
      transform: translateY(-8px);
    }

    .person-photo {
      width: 100%;
      aspect-ratio: 3 / 4;
      border-radius: var(--radius-md);
      object-fit: cover;
      object-position: center;
      filter: grayscale(0%);
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
    }
    .person-card:hover .person-photo {
      transform: scale(1.03);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
    }

    .person-desc {
      font-size: 0.75rem;
      color: rgba(220,232,245,0.65);
      line-height: 1.5;
    }

    .person-points {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .person-points li {
      position: relative;
      padding-left: 0.9rem;
      font-size: 0.75rem;
      line-height: 1.6;
      color: rgba(220,232,245,0.65);
      text-align: justify;
      text-justify: inter-word;
      hyphens: auto;
    }
    .person-points li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.55em;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--accent);
    }

    .person-name {
      font-family: var(--font-display);
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--white);
      line-height: 1.3;
      transition: color 0.3s ease;
    }
    .person-card:hover .person-name {
      color: var(--blue-tint);
    }
    .person-role {
      font-size: 0.75rem;
      color: rgba(220,232,245,0.6);
      letter-spacing: 0.02em;
    }

    /* ─── SECTION 7 — WHY US ──────────────────────────────────────────── */
    .why-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: start;
    }
    .why-left {
      position: sticky;
      top: 100px;
    }
    .why-left .section-intro { max-width: 38ch; }

    .diff-list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 2.5rem;
      margin-top: 0;
    }
    .diff-item {
      padding: 1.5rem 0;
      border-bottom: 1px solid var(--border-subtle);
      display: grid;
      grid-template-columns: 40px 1fr;
      gap: 1rem;
      align-items: start;
      transition: background 0.2s;
    }
    /* Top rule on the first item of each column */
    .diff-item:nth-child(1),
    .diff-item:nth-child(2) { border-top: 1px solid var(--border-subtle); }

    .diff-num {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 400;
      color: var(--border);
      line-height: 1;
      padding-top: 2px;
    }
    .diff-title {
      font-family: var(--font-display);
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--ink-900);
      margin-bottom: 0.5rem;
    }
    .diff-body {
      font-size: 0.875rem;
      color: var(--muted);
      line-height: 1.75;
    }

    /* ── Why Us — KLCC backdrop, washed light ── */
    #why-us {
      position: relative;
      isolation: isolate;
      background: var(--white);
    }
    #why-us::before,
    #why-us::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -2;
    }
    #why-us::before {
      background-image: url('https://images.unsplash.com/photo-1566914447826-bf04e54bf1be?w=1800&q=80&fm=jpg&fit=crop');
      background-size: cover;
      background-position: center 40%;
    }
    #why-us::after {
      z-index: -1;
      background: rgba(255,255,255,0.9);
    }

    /* ─── SECTION 8 — CONTACT ────────────────────────────────────────── */
    #contact {
      color: var(--white);
      position: relative;
      isolation: isolate;
      background: var(--navy-900);
    }
    #contact::before,
    #
    contact::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -2;
    }
    #contact::before {
      background-image: url('https://images.unsplash.com/photo-1596422846543-75c6fc197f07?w=1800&q=85');
      background-size: cover;
      background-position: center 30%;
    }
    #contact::after {
      z-index: -1;
      background: linear-gradient(135deg, rgba(30,90,150,0.93) 0%, rgba(45,74,124,0.93) 100%);
    }
    #contact .section-label {
      color: rgba(255,255,255,0.7);
    }
    #contact .section-label::before {
      background: rgba(255,255,255,0.5);
    }
    #contact .section-title {
      color: var(--white);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1.5fr;
      gap: 5rem;
      align-items: start;
    }

    .contact-left {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .contact-quote {
      background: transparent;
      border-left: none;
      padding: 0;
      font-family: var(--font-display);
      font-style: normal;
      font-size: 0.95rem;
      color: rgba(255,255,255,0.85);
      line-height: 1.65;
    }

    .contact-details {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .contact-row-label {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.9);
      display: block;
      margin-bottom: 0.25rem;
    }
    .contact-row-value {
      font-size: 0.875rem;
      color: rgba(255,255,255,0.85);
      line-height: 1.5;
    }

    /* Contact form */
    .contact-form {
      background: transparent;
      border: none;
      border-radius: 0;
      padding: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .form-title {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--white);
      margin-bottom: 0.25rem;
      grid-column: 1 / -1;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .form-group label {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: capitalize;
      color: rgba(255,255,255,0.9);
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      padding: 0.75rem 1rem;
      background: #ffffff;
      border: none;
      border-radius: 2px;
      color: #1a2744;
      font-family: var(--font-body);
      font-size: 0.875rem;
      outline: none;
      transition: background 0.2s;
    }
    .form-group input::placeholder,
    .form-group textarea::placeholder { color: #ccc; }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      background: #f9f9f9;
    }
    .form-group select {
      appearance: none;
      cursor: pointer;
      background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l4 4 4-4' stroke='%236b7a99' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E");
      background-repeat: no-repeat;
      background-position: right 1rem center;
      padding-right: 2.5rem;
    }
    .form-group textarea { resize: vertical; min-height: 110px; }

    .form-row-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .btn-submit {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.9rem 1.5rem;
      background: var(--navy-900);
      color: var(--white);
      border: none;
      border-radius: 4px;
      font-family: var(--font-body);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
      width: 100%;
      transition: background 0.2s;
    }
    .btn-submit:hover {
      background: var(--navy-800);
    }

    .form-note {
      font-size: 0.72rem;
      color: var(--muted);
      text-align: center;
      line-height: 1.6;
    }

    /* ─── FOOTER ─────────────────────────────────────────────────────── */
    .footer {
      position: relative;
      z-index: 20;
      background: var(--white);
      padding-block: 3rem;
      border-top: 1px solid rgba(255,255,255,0.08);
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.5rem;
    }

    .footer-brand { display: flex; flex-direction: column; gap: 0.35rem; }
    .footer-name {
      font-family: var(--font-display);
      font-size: 1rem;
      font-weight: 600;
      color: var(--black);
    }
    .footer-reg {
      font-size: 0.68rem;
      color: rgba(0,0,0,0.5);
      letter-spacing: 0.04em;
    }

    .footer-links {
      display: flex;
      gap: 1.75rem;
      list-style: none;
      flex-wrap: wrap;
    }
    .footer-links a {
      font-size: 0.78rem;
      color: rgba(0,0,0,0.7);
      text-decoration: none;
      letter-spacing: 0.04em;
      transition: color 0.2s;
    }
    .footer-links a:hover { color: var(--black); }

    .footer-location {
      font-size: 0.72rem;
      color: rgba(0,0,0,0.5);
      letter-spacing: 0.06em;
    }

    /* ─── RESPONSIVE ─────────────────────────────────────────────────── */
    /* Nav collapses to hamburger before the logo+links+CTA row runs out of room */
    @media (max-width: 900px) {
      .nav-links, .nav-cta { display: none; }
      .nav-hamburger { display: flex; }
    }

    @media (max-width: 960px) {
      .hero-inner { grid-template-columns: 1fr; gap: 2.5rem; padding-block: 4rem 3rem; }
      .hero-left { gap: 1.5rem; }
      .hero-right { gap: 1.5rem; }
      .hero-desc { max-width: 100%; }
      .hero-bg::before { right: 0; }
      .about-header { grid-template-columns: 1fr; gap: 1.5rem; }
      .pillar-grid { grid-template-columns: 1fr 1fr; }
      .purpose-row { grid-template-columns: 1fr; gap: 0.75rem; }
      .target-header { grid-template-columns: 1fr; gap: 1rem; }
      .target-blurb { padding-top: 0; }
      .target-columns { grid-template-columns: 1fr; gap: 1.5rem; }
      .target-col:last-child { padding-left: 0; }
      .target-col:last-child::before { display: none; }
      .industry-grid { grid-template-columns: 1fr 1fr; }
      .people-grid { grid-template-columns: repeat(2, 1fr); }
      .people-grid.board-grid { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; align-items: stretch; }
      .people-grid.team-grid { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; max-width: 100%; }
      .why-layout { grid-template-columns: 1fr; gap: 3rem; }
      .why-left { position: static; }
      .diff-list { grid-template-columns: 1fr 1fr; }
      .contact-grid { grid-template-columns: 1fr; gap: 3rem; }
      .contact-form { grid-template-columns: 1fr; gap: 1.5rem; }
    }

    @media (max-width: 680px) {
      .pillar-grid { grid-template-columns: 1fr; }
      .industry-grid { grid-template-columns: 1fr; }
      .people-grid { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
      .people-grid.board-grid { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
      .person-card--featured {
        grid-column: 1 / -1;
        order: -1;
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 1.25rem;
        margin-bottom: 0.5rem;
      }
      .person-card--featured .person-photo {
        width: 45%;
        flex-shrink: 0;
      }
      .person-card--featured .person-info {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding-top: 0.25rem;
      }
      .diff-list { grid-template-columns: 1fr; }
      .diff-item:nth-child(2) { border-top: none; }
      .people-grid.team-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
      .contact-details { grid-template-columns: 1fr; }
      .form-row-2 { grid-template-columns: 1fr; }
      .footer-inner { flex-direction: column; align-items: flex-start; }
      .footer-links { gap: 1rem; }
    }

    @media (max-width: 400px) {
      .hero-eyebrow { margin-bottom: 1rem; }
      .hero-actions { gap: 1rem; }
      .btn-primary, .btn-outline-light { padding: 0.8rem 1.4rem; }
      .people-grid.team-grid { grid-template-columns: repeat(2, 1fr); }
    }

    /* ─── HERO FADE-IN ────────────────────────────────────────────────────
       Two-stage fade, matching a plain block reveal (no per-word stagger).
    ──────────────────────────────────────────────────────────────────── */
    @keyframes heroFadeIn {
      from {
        opacity: 0;
        transform: translateY(24px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .hw {
      opacity: 0;
      animation: heroFadeIn 1.2s cubic-bezier(0.445, 0.05, 0.55, 0.9) both;
    }

    .hw-1 { animation-delay: 0.2s; }
    .hw-2 { animation-delay: 0.6s; }

    /* ─── SCROLL-TRIGGERED ENTRANCE ANIMATIONS ──────────────────────────
       All animations use only transform / opacity / filter (GPU-accelerated).
       Initial hidden states are applied via data-anim attribute.
       `.is-visible` triggers the transition to the final visible state.
       `will-change` is removed once the animation completes to free memory.
    ──────────────────────────────────────────────────────────────────── */

    /* ── Shared base transition ── */
    [data-anim] {
      transition-duration: 0.75s;
      transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
      transition-property: opacity, transform, filter;
      transition-delay: var(--anim-delay, 0s); /* set --anim-delay inline on any element */
      will-change: opacity, transform, filter;
    }

    /* ── S1 · Fade-in + Slide-up ── */
    [data-anim="fade-up"] {
      opacity: 0;
      transform: translateY(48px);
    }
    [data-anim="fade-up"].is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* ── S2 · Slide-in from left ── */
    [data-anim="slide-left"] {
      opacity: 0;
      transform: translateX(-72px);
    }
    [data-anim="slide-left"].is-visible {
      opacity: 1;
      transform: translateX(0);
    }

    /* ── S3 · Slide-in from right ── */
    [data-anim="slide-right"] {
      opacity: 0;
      transform: translateX(72px);
    }
    [data-anim="slide-right"].is-visible {
      opacity: 1;
      transform: translateX(0);
    }

    /* ── S4 · Scale-up / Zoom-in ── */
    [data-anim="scale-up"] {
      opacity: 0;
      transform: scale(0.88);
    }
    [data-anim="scale-up"].is-visible {
      opacity: 1;
      transform: scale(1);
    }

    /* ── S8 · Staggered child fade-in (.pillar-card children) ── */
    [data-anim="stagger"] > * {
      opacity: 0;
      transform: translateY(32px);
      transition:
        opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }
    [data-anim="stagger"].is-visible > *:nth-child(1) { opacity: 1; transform: translateY(0); transition-delay: 1.25s; }
    [data-anim="stagger"].is-visible > *:nth-child(2) { opacity: 1; transform: translateY(0); transition-delay: 1.75s; }
    [data-anim="stagger"].is-visible > *:nth-child(3) { opacity: 1; transform: translateY(0); transition-delay: 2.25s; }
    [data-anim="stagger"].is-visible > *:nth-child(4) { opacity: 1; transform: translateY(0); transition-delay: 1.0s; }
    [data-anim="stagger"].is-visible > *:nth-child(5) { opacity: 1; transform: translateY(0); transition-delay: 2.0s; }
    [data-anim="stagger"].is-visible > *:nth-child(6) { opacity: 1; transform: translateY(0); transition-delay: 2.5s; }

    /* Respect prefers-reduced-motion */
    @media (prefers-reduced-motion: reduce) {
      [data-anim],
      [data-anim] > *,
      .hw {
        transition: none !important;
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
      }
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
  <header class="nav">
    <div class="wrap">
      <nav class="nav-inner">
        <a href="#hook" class="nav-wordmark">
          <img src={logo.src} alt="Flowstate Advisors Logo" width="48" height="48">
          <span>
            <span class="wm-top">Flowstate Advisors</span>
            <span class="wm-sub">Corporate Advisory</span>
          </span>
        </a>

        <ul class="nav-links">
          <li><a href="#about">About</a></li>
          <li><a href="#purpose">Purpose</a></li>
          <li><a href="#target">Target</a></li>
          <li><a href="#people">Board & Team</a></li>
          <li><a href="#why-us">Why Us</a></li>
        </ul>

        <a href="#contact" class="nav-cta">Get In Touch</a>

        <button class="nav-hamburger" id="navBtn" aria-label="Open navigation">
          <span></span><span></span><span></span>
        </button>
      </nav>

      <div class="mobile-nav" id="mobileNav">
        <a href="#about">About</a>
        <a href="#purpose">Purpose</a>
        <a href="#target">Target</a>
        <a href="#people">Board & Team</a>
        <a href="#why-us">Why Us</a>
        <a href="#contact">Get In Touch</a>
      </div>
    </div>
  </header>

  <main>

    <!-- SECTION 1 — HOOK / HERO -->
    <section class="hero" id="hook">
      <div class="hero-bg"></div>

      <div class="wrap hero-inner">
        <div class="hero-left">
          <h1 class="hero-h1 hw hw-1">
            <span>Flowstate</span>
            <em>Advisors</em>
          </h1>
          <p class="hero-tagline hw hw-1">{firm.quote}</p>
          <div class="hero-action hw hw-2">
            <a href="#contact" class="btn-primary">Get In Touch</a>
            <a href="#about" class="btn-outline-light">Learn More</a>
          </div>
        </div>
        <div class="hero-right">
          <div class="hero-actions hw hw-2">
          </div>
        </div>
      </div>

      <div class="hero-scroll" aria-hidden="true">
        <span class="scroll-label">Scroll</span>
        <div class="scroll-line"></div>
      </div>
    </section>

    <!-- SECTION 2 — ABOUT (white) -->
    <section class="section section--white" id="about">
      <div class="wrap">
        <div class="about-header" data-anim="slide-left" style="--anim-delay: 0.5s;">
          <div>
            <h2 class="section-title mt-5">About <em>Flowstate</em></h2>
          </div>
          <p class="section-intro">{firm.description}</p>
        </div>

        <div class="pillar-grid" data-anim="stagger" >
          {aboutPillars.map(p => (
            <div class="pillar-card">
              <div class="pillar-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" set:html={p.icon} />
              </div>
              <h3 class="pillar-title">{p.title}</h3>
              <p class="pillar-body">{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SECTION 3 — PURPOSE (tint) -->
    <section class="section section--tint" id="purpose">
      <div class="wrap">

        <!-- Label and title float up individually -->
        
        <h2 class="section-title" data-anim="fade-up" style="--anim-delay: 0.4s;">Advisory Built Around <em>Outcomes</em></h2>
        <span class="section-label" data-anim="fade-up" style="--anim-delay: 0s;">Strategy, deals and public-sector advisory under one roof</span>

        <!-- Each row floats up in sequence after the title -->
        <div class="purpose-list">
          {purposeItems.map((item, i) => (
            <div class="purpose-row" data-anim="fade-up" style={`--anim-delay: ${1.0 + i * 0.5}s;`}>
              <div class="purpose-heading">
                <span class="purpose-num">0{i + 1}</span>
                <span class="purpose-title">{item.title}</span>
              </div>
              <p class="purpose-desc">{item.description}</p>
              <p class="purpose-tags">
                {item.tags.map((tag, ti) => (
                  <>
                    {ti > 0 && <span class="sep">·</span>}
                    {tag}
                  </>
                ))}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SECTION 4 — TARGET (white) -->
    <section class="section section--white" id="target">
      <div class="wrap">

        <div class="target-header">
          <div>
            <span class="target-eyebrow" data-anim="fade-up" style="--anim-delay: 0s;">04 · Clients &amp; Sectors</span>
            <h2 class="target-title" data-anim="fade-up" style="--anim-delay: 0.4s;">Who We Serve</h2>
          </div>
          <p class="target-blurb" data-anim="fade-up" style="--anim-delay: 0.8s;">
            From founders and family businesses to governments and sovereign institutions,
            we advise across the full spectrum.
          </p>
        </div>

        <div class="target-rule" data-anim="fade-up" style="--anim-delay: 1.0s;"></div>

        <div class="target-columns">
          {targetColumns.map((col, i) => (
            <div class="target-col" data-anim="fade-up" style={`--anim-delay: ${1.2 + i * 0.4}s;`}>
              <span class="target-col-label">{col.label}</span>
              <p class="target-items">
                {col.items.map((item, j) => (
                  <>
                    {j > 0 && <span class="sep">·</span>}
                    <span>{item}</span>
                  </>
                ))}
              </p>
            </div>
          ))}
        </div>

        <div class="target-footer" data-anim="fade-up" style="--anim-delay: 2.0s;">
          <span class="target-caption">A single adviser across the private-to-public spectrum</span>
          <span class="target-gradient-bar"></span>
        </div>

        <h3 class="industries-title" data-anim="fade-up" style="--anim-delay: 2.4s;">Industries We Serve</h3>

        <div class="industry-grid">
          {industries.map((ind, i) => (
            <div class="industry-card" data-accent={ind.accent}
                 data-anim="fade-up" style={`--anim-delay: ${2.8 + i * 0.4}s;`}>
              <img
                src={ind.img}
                alt={ind.title}
                class="industry-img"
                loading="lazy"
              />
              <div class="industry-body">
                <div class="industry-line"></div>
                <h4 class="industry-title">{ind.title}</h4>
                <ul class="industry-list">
                  {ind.items.map(item => (
                    <li><span class="dot"></span>{item}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SECTION 5+6 — BOARD & TEAM gabungan (navy) -->
    <section class="section section--navy" id="people" data-anim="fade-up">
      <div class="wrap">
        <span class="section-label">Our People</span>
        <h2 class="section-title">Board & <em>Team</em></h2>
        <p class="section-intro">
          Experienced principals and advisors across corporate finance, strategy,
          and public sector advisory.
        </p>

        <!-- Board -->
        <div style="margin-top: 3rem;">
          <p class="people-section-title" style="color: rgba(220,232,245,0.5); border-color: rgba(255,255,255,0.08);">
            Board of Directors
          </p>
          <div class="people-grid board-grid">
            {board.map(m => (
              m.title === "Executive Chairman" ? (
                <div class="person-card person-card--featured">
                  <img
                    src={m.img}
                    alt={m.name}
                    class="person-photo"
                    loading="lazy"
                  />
                  <div class="person-info">
                    <div>
                      <span class="person-name">{m.name}</span>
                      <br>
                      <span class="person-role">{m.title}</span>
                    </div>
                    <ul class="person-points">
                      {m.points.map(p => (
                        <li>{p}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              ) : (
                <div class="person-card">
                  <img
                    src={m.img}
                    alt={m.name}
                    class="person-photo"
                    loading="lazy"
                  />
                  <div>
                    <span class="person-name">{m.name}</span>
                    <br>
                    <span class="person-role">{m.title}</span>
                  </div>
                  <ul class="person-points">
                    {m.points.map(p => (
                      <li>{p}</li>
                    ))}
                  </ul>
                </div>
              )
            ))}
          </div>
        </div>

        <!-- Team -->
        <div style="margin-top: 3.5rem;">
          <p class="people-section-title" style="color: rgba(220,232,245,0.5); border-color: rgba(255,255,255,0.08);">
            Execution Team
          </p>
          <div class="people-grid team-grid">
            {team.map(m => (
              <div class="person-card">
                <img
                  src={m.img}
                  alt={m.name}
                  class="person-photo"
                  loading="lazy"
                />
                <div>
                  <span class="person-name">{m.name}</span>
                  <br>
                  <span class="person-role">{m.title}</span>
                </div>
                <ul class="person-points">
                  {m.points.map(p => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 7 — WHY US (tint) -->
    <section class="section section--tint" id="why-us" data-anim="slide-left">
      <div class="wrap">
        <div class="why-layout">
          <div class="why-left">
            <span class="section-label">Why Flowstate</span>
            <h2 class="section-title">
              The Firm Built for<br/>
              <em>Clients Who Demand More</em>
            </h2>
            <p class="section-intro">
              Trusted advice, rigorous analysis,
              and practical solutions. Delivered with senior commitment on every engagement.
            </p>
          </div>

          <div class="diff-list">
            {differentiators.map((d, i) => (
              <div class="diff-item">
                <span class="diff-num">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h3 class="diff-title">{d.title.replace(/^\d+\s+/, "")}</h3>
                  <p class="diff-body">{d.body}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 8 — CONTACT (white) -->
    <section class="section section--white" id="contact" data-anim="fade-up">
      <div class="wrap">
        <span class="section-label">08 · Get In Touch</span>
        <h2 class="section-title" style="margin-bottom: 3rem;">
          Let's Begin the<br/><em>Conversation</em>
        </h2>

        <div class="contact-grid">
          <div class="contact-left">
            <p class="contact-quote">
              Every engagement starts with a confidential discussion, to understand
              your objectives and how we can help.
            </p>

            <div class="contact-details">
              <div>
                <span class="contact-row-label">Address</span>
                <span class="contact-row-value">{firm.address}</span>
              </div>
              <div>
                <span class="contact-row-label">Phone</span>
                <span class="contact-row-value">{firm.phone}</span>
              </div>
              <div>
                <span class="contact-row-label">Email</span>
                <span class="contact-row-value">{firm.email}</span>
              </div>
              <div>
                <span class="contact-row-label">Website</span>
                <span class="contact-row-value">{firm.website}</span>
              </div>
            </div>

            <p style="font-size: 0.8rem; color: var(--muted); font-style: italic; margin-top: 0.5rem;">
              All discussions held in strict confidence.
            </p>
          </div>

          <form class="contact-form" action="#" method="POST">
            <h3 class="form-title">Ready when you are.</h3>

            <div class="form-row-2">
              <div class="form-group">
                <label for="name">Full Name</label>
                <input type="text" id="name" name="name" placeholder="Your name" required />
              </div>
              <div class="form-group">
                <label for="org">Organisation</label>
                <input type="text" id="org" name="org" placeholder="Your company" />
              </div>
            </div>

            <div class="form-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" placeholder="you@company.com" required />
            </div>

            <div class="form-group">
              <label for="service">Nature of Enquiry</label>
              <select id="service" name="service">
                <option value="">Select a service area</option>
                <option>Corporate Finance & M&A</option>
                <option>Strategy & Corporate Advisory</option>
                <option>Government & Public Sector</option>
                <option>Investment & Strategic Assets</option>
                <option>General Enquiry</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Brief Description</label>
              <textarea id="message" name="message" placeholder="Please describe your situation briefly. All information shared is strictly confidential."></textarea>
            </div>

            <button type="submit" class="btn-submit">
              Submit Enquiry
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M2.5 7h9M8 3.5l3.5 3.5L8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>

            <p class="form-note">
              Your enquiry is treated with strict confidentiality.<br/>
              We respond to all submissions within one business day.
            </p>
          </form>
        </div>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="wrap">
      <div class="footer-inner">
        <div class="footer-brand">
          <span class="footer-name">Flowstate Advisors</span>
          <span class="footer-reg">© {new Date().getFullYear()} Flowstate Advisors Sdn Bhd. All rights reserved.</span>
        </div>

        <ul class="footer-links">
          <li><a href="#about">About</a></li>
          <li><a href="#purpose">Purpose</a></li>
          <li><a href="#target">Target</a></li>
          <li><a href="#people">Board & Team</a></li>
          <li><a href="#why-us">Why Us</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>

        <span class="footer-location">{firm.location}</span>
      </div>
    </div>
  </footer>

  <script>
    const btn = document.getElementById('navBtn');
    const menu = document.getElementById('mobileNav');
    btn?.addEventListener('click', () => menu?.classList.toggle('open'));
    menu?.querySelectorAll('a').forEach(l => l.addEventListener('click', () => menu.classList.remove('open')));
  </script>

  <!-- ─── SCROLL-TRIGGERED ENTRANCE ANIMATIONS ──────────────────────── -->
  <script>
    // Disable browser scroll restoration
    if ('scrollRestoration' in window.history) {
      window.history.scrollRestoration = 'manual';
    }

    // A leftover #hash in the URL (from a prior nav click) makes the
    // browser auto-scroll to that section on every reload — even before
    // our own JS runs. Strip it so a refresh always lands on the hero.
    if (window.location.hash) {
      history.replaceState(null, '', window.location.pathname + window.location.search);
    }

    const forceTop = () => {
      window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
      document.documentElement.scrollTop = 0;
      document.body.scrollTop = 0;
    };

    forceTop();
    document.addEventListener('DOMContentLoaded', forceTop);
    window.addEventListener('load', forceTop);

    (function () {
      // Respect reduced-motion preference — if set, skip all JS work entirely
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      /**
       * A single IntersectionObserver handles all animated elements.
       * threshold: 0.2  → trigger when 20% of the element is in the viewport.
       * rootMargin: 0px → no expansion of the intersection root.
       *
       * Once an element becomes visible we:
       *   1. Add `.is-visible` to start the CSS transition.
       *   2. Unobserve the element so it animates only once.
       *   3. Remove `will-change` after the transition ends to free GPU memory.
       */
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            const el = entry.target;
            el.classList.add('is-visible');

            // Free will-change after the longest possible transition (1s buffer)
            el.addEventListener(
              'transitionend',
              () => { el.style.willChange = 'auto'; },
              { once: true }
            );

            observer.unobserve(el);
          });
        },
        // threshold 0 + a bottom rootMargin keeps this reliable for sections
        // taller than the viewport, which can never reach a 0.2 ratio.
        { threshold: 0, rootMargin: '0px 0px -80px 0px' }
      );

      // Observe every element that carries a data-anim attribute.
      // This includes both section-level and child-container-level targets.
      document.querySelectorAll('[data-anim]').forEach((el) => {
        observer.observe(el);
      });

      // Note: the hero section (#hook) uses pure CSS keyframe animations
      // with `animation-delay` for its word-by-word float-up effect.
      // It does NOT use `data-anim` / IntersectionObserver — no JS needed there.
    })();
  </script>

</body>
</html>