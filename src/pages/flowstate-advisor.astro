---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={firm.description} />
  <title>{firm.name} — {firm.tagline}</title>
  <link rel="icon" type="image/png" href="/favicon.png?v=3" />
  <link rel="shortcut icon" type="image/png" href="/favicon.png?v=3" />
  <link rel="apple-touch-icon" href="/favicon.png?v=3" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />

  <style>
    /* ─── DESIGN TOKENS ──────────────────────────────────────────────────
       Colour palette extracted dari Flowstate corporate profile:
       Dark navy (#1a2744) + light blue tint (#dce8f5) + accent blue (#4a7ab5)
    ──────────────────────────────────────────────────────────────────── */
    :root {
      /* Primary palette — dari corporate profile */
      --navy-900:   #1a2744;
      --navy-800:   #1e3a5f;
      --navy-700:   #243858;
      --blue-tint:  #dce8f5;
      --blue-light: #eef4fb;
      --accent:     #4a7ab5;
      --accent-dark:#3a6295;

      /* Neutrals */
      --white:      #ffffff;
      --off-white:  #f8fafc;
      --ink-900:    #1a2744;
      --ink-700:    #2d3f5e;
      --muted:      #6b7a99;

      /* Industry accents */
      --acc-blue:   #4a7ab5;
      --acc-gold:   #B08A2E;
      --acc-green:  #46795E;

      /* Borders */
      --border:        rgba(26,39,68,0.12);
      --border-subtle: rgba(26,39,68,0.07);
      --border-light:  rgba(255,255,255,0.12);

      /* Fonts */
      --font-display: 'Playfair Display', Georgia, serif;
      --font-body:    'Inter', system-ui, sans-serif;

      /* Layout */
      --container: 1200px;
      --pad-x:     clamp(1.25rem, 5vw, 3rem);
      --section-y: clamp(4.5rem, 8vw, 7rem);

      /* Radius */
      --radius-sm: 4px;
      --radius-md: 8px;
      --radius-lg: 12px;
    }

    /* ─── RESET ──────────────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html {
      scroll-behavior: smooth;
      overscroll-behavior-y: none;
      overflow-x: hidden;
      width: 100%;
    }
    body {
      font-family: var(--font-body);
      background: var(--navy-900);
      color: var(--ink-900);
      line-height: 1.65;
      overscroll-behavior-y: none;
      overflow-x: hidden;
      width: 100%;
      -webkit-font-smoothing: antialiased;
    }
    img { max-width: 100%; display: block; object-fit: cover; }
    a { color: inherit; }

    /* ─── LAYOUT UTILITIES ───────────────────────────────────────────── */
    .wrap {
      max-width: var(--container);
      margin-inline: auto;
      padding-inline: var(--pad-x);
    }

    .section {
      position: relative;
      z-index: 20;
      padding-block: var(--section-y);
    }
    .section--tint { background: var(--blue-tint); }
    .section--white { background: var(--white); }
    .section--navy {
      background: var(--navy-900);
      color: var(--white);
    }

    /* Section labels */
    .section-label {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 1.25rem;
    }
    .section-label::before {
      content: '';
      display: block;
      width: 24px;
      height: 1px;
      background: var(--accent);
    }
    .section--navy .section-label {
      color: rgba(220,232,245,0.7);
    }
    .section--navy .section-label::before {
      background: rgba(220,232,245,0.5);
    }

    /* Section titles */
    .section-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 3.5vw, 2.85rem);
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: -0.01em;
      color: var(--ink-900);
    }
    .section--navy .section-title { color: var(--white); }

    .section-title em {
      font-style: italic;
      color: var(--accent);
    }
    .section--navy .section-title em { color: var(--blue-tint); }

    .section-intro {
      font-size: 0.95rem;
      color: var(--muted);
      line-height: 1.8;
      max-width: 60ch;
      margin-top: 1rem;
    }
    .section--navy .section-intro { color: rgba(220,232,245,0.65); }

    /* ─── NAVBAR ─────────────────────────────────────────────────────── */
    .nav {
      position: fixed;
      inset: 0 0 auto 0;
      z-index: 200;
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      gap: 2rem;
      padding-block: 1rem;
    }

    .nav-wordmark {
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.65rem;
      flex-shrink: 0;
    }
    .logo-mark {
      width: 34px; height: 34px;
      border-radius: var(--radius-sm);
      background: var(--navy-900);
      color: var(--blue-tint);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      font-size: 0.85rem;
      font-weight: 700;
      flex-shrink: 0;
      letter-spacing: 0.02em;
    }
    .wm-top {
      font-family: var(--font-display);
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--navy-900);
      display: block;
      line-height: 1;
    }
    .wm-sub {
      font-size: 0.58rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--accent);
      display: block;
      margin-top: 3px;
    }

    .nav-links {
      display: flex;
      gap: 0;
      margin-left: auto;
      list-style: none;
    }
    .nav-links a {
      display: block;
      padding: 0.45rem 0.75rem;
      font-size: 0.78rem;
      font-weight: 500;
      letter-spacing: 0.02em;
      color: var(--muted);
      text-decoration: none;
      border-radius: var(--radius-sm);
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--navy-900); }

    .nav-cta {
      display: inline-block;
      padding: 0.55rem 1.25rem;
      background: var(--navy-900);
      color: var(--white);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
      border-radius: var(--radius-sm);
      transition: background 0.2s;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .nav-cta:hover { background: var(--navy-800); }

    .nav-hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 6px;
      margin-left: auto;
    }
    .nav-hamburger span {
      display: block;
      width: 20px; height: 1.5px;
      background: var(--navy-900);
      transition: all 0.3s;
    }

    .mobile-nav {
      display: none;
      flex-direction: column;
      padding: 1rem var(--pad-x) 1.5rem;
      gap: 0;
      border-top: 1px solid var(--border-subtle);
    }
    .mobile-nav.open { display: flex; }
    .mobile-nav a {
      padding: 0.75rem 0.5rem;
      font-size: 0.875rem;
      color: var(--muted);
      text-decoration: none;
      border-bottom: 1px solid var(--border-subtle);
      transition: color 0.2s;
    }
    .mobile-nav a:last-child { border-bottom: none; }
    .mobile-nav a:hover { color: var(--navy-900); }

    /* ─── SECTION 1 — HERO / HOOK ────────────────────────────────────── */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-top: 0;
      overflow: visible;
      z-index: 1;
      scroll-margin-top: 0;
    }

    /* KLCC background — sticky/fixed on scroll */
    .hero-bg {
      position: fixed;
      inset: 0;
      background-image: url('https://images.unsplash.com/photo-1596422846543-75c6fc197f07?w=1800&q=85');
      background-size: cover;
      background-position: center 30%;
      z-index: -10;
    }

    /* Overlay for text contrast */
    .hero-bg::after {
      content: '';
      position: fixed;
      inset: 0;
      background: linear-gradient(to right, rgba(26,39,68,0.75) 0%, rgba(26,39,68,0.55) 50%, rgba(26,39,68,0.3) 100%);
      z-index: -9;
    }

    /* Left-side blue gradient overlay */
    .hero-bg::before {
      content: '';
      position: fixed;
      inset: 0;
      right: 40%;
      background: linear-gradient(to right, var(--navy-800) 0%, rgba(74,122,181,0) 100%);
      z-index: -8;
      pointer-events: none;
    }

    .hero-inner {
      position: relative;
      z-index: 10;
      width: 100%;
      padding-block: clamp(3rem, 8vw, 6rem);
      display: grid;
      grid-template-columns: 0.75fr 1fr;
      align-items: center;
      justify-items: start;
      gap: 4rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .hero-left {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      align-items: center;
      text-align: center;
      margin-left: -20%;
    }

    .gradient{
      background: linear-gradient(to right, var(--accent), var(--navy-800));
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.7);
      margin-bottom: 1.5rem;
    }
    .hero-eyebrow::before {
      content: '';
      display: block;
      width: 32px;
      height: 1px;
      background: rgba(255,255,255,0.5);
    }

    .hero-h1 {
      font-family: var(--font-display);
      font-size: clamp(2.75rem, 6vw + 1.5rem, 4.5rem);
      font-weight: 400;
      line-height: 1.12;
      letter-spacing: -0.02em;
      color: var(--white);
      margin-bottom: 0;
      text-shadow: 0 4px 28px rgba(0,0,0,0.35);
    }
    .hero-h1 span {
      display: block;
    }
    .hero-h1 em {
      font-style: italic;
      color: var(--white);
      display: block;
      font-weight: 400;
    }
    .hero-h1-logo img {
      display: block;
      width: min(640px, 100%);
      height: auto;
      filter: drop-shadow(0 4px 28px rgba(0,0,0,0.35));
    }

    .hero-tagline {
      display: block;
      font-family: var(--font-display);
      font-size: clamp(0.9rem, 1.5vw, 1.05rem);
      font-style: italic;
      font-weight: 400;
      color: rgba(255,255,255,0.75);
      margin-top: 0;
      letter-spacing: 0.01em;
    }

    .hero-right {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      align-items: flex-start;
      justify-content: center;
    }

    .hero-desc {
      font-size: 0.95rem;
      color: rgba(255,255,255,0.8);
      line-height: 1.75;
      max-width: 380px;
      font-weight: 400;
    }

    .hero-actions {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
      justify-content: flex-start;
    }

    .btn-primary {
      display: inline-block;
      padding: 0.9rem 2rem;
      background: var(--white);
      color: var(--navy-900);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      border-radius: 3px;
      transition: background 0.2s, box-shadow 0.2s;
      white-space: nowrap;
    }
    .btn-primary:hover {
      background: rgba(255,255,255,0.95);
      box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }

    .btn-outline-light {
      display: inline-block;
      padding: 0.9rem 1.75rem;
      border: none;
      background: transparent;
      color: var(--white);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-decoration: none;
      border-radius: 3px;
      transition: color 0.2s, opacity 0.2s;
      white-space: nowrap;
    }
    .btn-outline-light:hover {
      color: rgba(255,255,255,0.7);
      opacity: 0.8;
    }

    /* Scroll indicator */
    .hero-scroll {
      position: absolute;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }
    .scroll-label {
      font-size: 0.6rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(220,232,245,0.45);
    }
    .scroll-line {
      width: 1px;
      height: 40px;
      background: linear-gradient(to bottom, rgba(220,232,245,0.4), transparent);
      animation: scrollPulse 2s ease infinite;
    }
    @keyframes scrollPulse {
      0%, 100% { opacity: 0.4; transform: scaleY(1); }
      50% { opacity: 1; transform: scaleY(0.7); }
    }

    /* ─── SECTION 2 — ABOUT ──────────────────────────────────────────── */
    .about-header {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }

    .pillar-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-top: 3.5rem;
    }

    .pillar-card {
      padding: 2rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      display: flex;
      flex-direction: column;
      gap: 1rem;
      background: var(--white);
      transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
    }
    .pillar-card:hover {
      transform: translateY(-4px);
      border-color: var(--accent);
      box-shadow: 0 16px 40px rgba(26,39,68,0.1);
    }

    .pillar-icon {
      width: 36px; height: 36px;
      color: var(--accent);
    }
    .pillar-icon svg { width: 100%; height: 100%; }

    .pillar-title {
      font-family: var(--font-display);
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--ink-900);
    }
    .pillar-body {
      font-size: 0.85rem;
      color: var(--muted);
      line-height: 1.7;
      white-space: pre-line;
    }

    /* ─── SECTION 3 — PURPOSE ────────────────────────────────────────── */
    .purpose-list {
      display: flex;
      flex-direction: column;
      gap: 1px;
      margin-top: 0;
      background: var(--border-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }

    .purpose-row {
      display: grid;
      grid-template-columns: 260px 1fr 320px;
      gap: 2.5rem;
      padding: 2rem 2.25rem;
      background: var(--blue-light);
      transition: background 0.2s;
      align-items: center;
      justify-items: start;
    }
    .purpose-row:hover { background: #e2ecf7; }

    .purpose-heading {
      display: flex;
      gap: 0.875rem;
      align-items: baseline;
    }
    .purpose-num {
      font-family: var(--font-display);
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--accent);
      flex-shrink: 0;
    }
    .purpose-title {
      font-family: var(--font-display);
      font-size: 1rem;
      font-weight: 600;
      color: var(--ink-900);
      line-height: 1.3;
    }
    .purpose-desc {
      font-size: 0.875rem;
      color: var(--ink-700);
      line-height: 1.7;
      text-align: justify;
    }
    .purpose-tags {
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--accent-dark);
      line-height: 1.5;
    }
    .purpose-tags .sep {
      color: var(--accent-dark);
      opacity: 0.8;
      margin: 0 0.35em;
    }

    /* ─── SECTION 4 — TARGET ─────────────────────────────────────────── */
    .target-header {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: start;
    }
    .target-eyebrow {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent);
      display: block;
      margin-bottom: 1rem;
    }
    .target-title {
      font-family: var(--font-display);
      font-size: clamp(2.25rem, 4vw, 3.25rem);
      font-weight: 700;
      color: var(--ink-900);
      line-height: 1.1;
    }
    .target-blurb {
      font-size: 1rem;
      color: var(--muted);
      line-height: 1.75;
      max-width: 40ch;
      padding-top: 2.5rem;
    }

    .target-rule {
      height: 1px;
      background: var(--border);
      margin-top: 2.5rem;
    }

    .target-columns {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      padding-block: 2.5rem;
      border-bottom: 1px solid var(--border-subtle);
    }
    .target-col { position: relative; }
    .target-col:last-child { padding-left: 2rem; }
    .target-col:last-child::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 1px;
      background: var(--border);
    }

    .target-col-label {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--navy-900);
      margin-bottom: 1.25rem;
      display: block;
    }
    .target-items {
      font-size: 0.93rem;
      color: var(--ink-700);
      line-height: 1.9;
    }
    .target-items .sep { color: var(--muted); margin: 0 0.5em; }

    .target-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      padding-top: 1.5rem;
      flex-wrap: wrap;
    }
    .target-caption {
      font-family: var(--font-display);
      font-style: italic;
      font-size: 0.88rem;
      color: var(--muted);
    }
    .target-gradient-bar {
      flex: 1;
      max-width: 300px;
      height: 2px;
      background: linear-gradient(to right, var(--accent), var(--navy-900));
    }

    .industries-title {
      font-family: var(--font-display);
      font-size: clamp(1.6rem, 2.8vw, 2.1rem);
      font-weight: 700;
      color: var(--ink-900);
      margin-top: 4rem;
      margin-bottom: 2rem;
    }

    .industry-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .industry-card {
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      background: var(--white);
      transition: transform 0.25s, box-shadow 0.25s;
    }
    .industry-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 40px rgba(26,39,68,0.1);
    }
    .industry-card[data-accent="blue"]  { border-top: 3px solid var(--acc-blue); }
    .industry-card[data-accent="gold"]  { border-top: 3px solid var(--acc-gold); }
    .industry-card[data-accent="green"] { border-top: 3px solid var(--acc-green); }

    .industry-img {
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
    }

    .industry-body { padding: 1.75rem; }
    .industry-line {
      width: 28px; height: 2px;
      margin-bottom: 1rem;
    }
    .industry-card[data-accent="blue"]  .industry-line { background: var(--acc-blue); }
    .industry-card[data-accent="gold"]  .industry-line { background: var(--acc-gold); }
    .industry-card[data-accent="green"] .industry-line { background: var(--acc-green); }

    .industry-title {
      font-family: var(--font-display);
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--ink-900);
      margin-bottom: 1rem;
    }
    .industry-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }
    .industry-list li {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      font-size: 0.875rem;
      color: var(--ink-700);
    }
    .dot {
      width: 5px; height: 5px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .industry-card[data-accent="blue"]  .dot { background: var(--acc-blue); }
    .industry-card[data-accent="gold"]  .dot { background: var(--acc-gold); }
    .industry-card[data-accent="green"] .dot { background: var(--acc-green); }

    /* ─── SECTION 5 — ENGAGEMENT PROCESS (minimalist) ────────────────── */
    #process {
      position: relative;
      z-index: 20;
      background: var(--navy-900);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .process-container {
      max-width: 1200px;
      margin-inline: auto;
      padding: 3rem 2rem;
    }

    .process-header {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid rgba(255,255,255,0.15);
    }

    .process-label {
      display: block;
      font-size: 12px;
      color: rgba(220,232,245,0.6);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 0.75rem;
    }

    .process-title {
      font-size: 42px;
      font-weight: 300;
      letter-spacing: -0.5px;
      color: #ffffff;
      line-height: 1.2;
      margin: 0;
    }

    .process-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 3rem;
      margin-bottom: 2rem;
    }

    .process-section-title {
      font-size: 18px;
      font-weight: 600;
      color: #ffffff;
      margin: 0 0 1.5rem 0;
    }

    .process-steps {
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }

    .process-step {
      display: flex;
      gap: 2rem;
      align-items: flex-start;
    }

    .process-step-num {
      min-width: 32px;
      flex-shrink: 0;
    }

    .process-step-num span {
      font-size: 18px;
      font-weight: 300;
      color: rgba(220,232,245,0.5);
    }

    .process-step-content h3 {
      font-size: 15px;
      font-weight: 600;
      color: #ffffff;
      margin: 0 0 0.5rem 0;
    }

    .process-step-content p {
      font-size: 13px;
      color: rgba(220,232,245,0.7);
      line-height: 1.6;
      margin: 0;
    }

    .process-sidebar {
      padding-left: 2rem;
      border-left: 1px solid rgba(255,255,255,0.15);
    }

    .process-sidebar-label {
      display: block;
      font-size: 12px;
      color: rgba(220,232,245,0.55);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 1.25rem;
    }

    .process-fee-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .process-fee-item {
      display: flex;
      gap: 0.75rem;
      align-items: flex-start;
    }

    .process-fee-sep {
      color: rgba(220,232,245,0.5);
      font-size: 13px;
      flex-shrink: 0;
    }

    .process-fee-item span:last-child {
      font-size: 13px;
      color: rgba(220,232,245,0.85);
      line-height: 1.6;
    }

    .process-divider {
      height: 1px;
      background: rgba(255,255,255,0.15);
      margin: 1.5rem 0;
    }

    .process-closing {
      font-size: 13px;
      color: rgba(220,232,245,0.7);
      line-height: 1.6;
      margin: 0;
    }

    .process-footer {
      border-top: 1px solid rgba(255,255,255,0.15);
      margin-top: 2rem;
      padding-top: 1.5rem;
      text-align: center;
    }

    .process-footer p {
      font-size: 11px;
      color: rgba(220,232,245,0.5);
      letter-spacing: 0.5px;
      margin: 0;
    }

    /* ─── SECTION 7 — WHY US (split layout) ─────────────────────────────── */
    .why-hero {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 0;
      align-items: stretch;
      border-radius: var(--radius-lg);
      overflow: hidden;
      min-height: auto;
    }

    .why-left-col {
      background: var(--blue-light);
      padding: 3rem clamp(2rem, 4vw, 3rem);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .why-label {
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--accent);
      display: block;
      margin-bottom: 1.5rem;
    }

    .why-heading {
      font-family: var(--font-display);
      font-size: clamp(1.75rem, 3vw, 2.2rem);
      font-weight: 600;
      color: var(--ink-900);
      line-height: 1.2;
      margin: 0 0 2rem 0;
    }

    .why-intro {
      font-size: 0.95rem;
      color: var(--ink-700);
      line-height: 1.75;
      font-style: italic;
      margin: 0;
    }

    .why-footer {
      font-size: 0.7rem;
      color: rgba(26, 39, 68, 0.5);
      letter-spacing: 0.06em;
      margin-top: auto;
      padding-top: 2rem;
      margin: 0;
    }

    .why-right-col {
      background: var(--navy-800);
      color: var(--white);
      padding: 3rem clamp(2rem, 4vw, 3rem);
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      gap: 1.75rem;
      position: relative;
      overflow: hidden;
    }

    .why-right-col::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url('https://images.unsplash.com/photo-1486312338219-ce68d2c6f44d?w=1800&q=80&crop=entropy&cs=tinysrgb&fit=max');
      background-size: cover;
      background-position: center;
      opacity: 0.08;
      z-index: 1;
    }

    .why-right-col > * {
      position: relative;
      z-index: 2;
    }

    .why-subheading {
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 2.5vw, 2rem);
      font-weight: 600;
      color: var(--blue-tint);
      line-height: 1.2;
      margin: 0 0 1rem 0;
    }

    .why-description {
      font-size: 0.9rem;
      color: rgba(220, 232, 245, 0.85);
      line-height: 1.7;
      font-style: italic;
